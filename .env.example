# --- Público (llega al navegador; seguro por RLS) ---
# Si se definen, la app usa Supabase para cuentas y sincronización. Si no, funciona en modo local (IndexedDB).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Privado (solo servidor de desarrollo / Edge Functions; NUNCA con prefijo VITE_) ---
# Coach IA (Claude). Sin esta clave el coach funciona en "modo datos" (respuestas deterministas, sin IA).
ANTHROPIC_API_KEY=
# USDA FoodData Central: clave gratuita en https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
